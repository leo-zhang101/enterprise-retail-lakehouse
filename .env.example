# Enterprise Retail Lakehouse Platform — Environment Variables
# Copy to .env and adjust for local development:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Storage backend: minio (local) or s3 (AWS)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=minio

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage) — used when STORAGE_BACKEND=minio
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 endpoint for Spark/ingestion (use minio when running in Docker network)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# -----------------------------------------------------------------------------
# AWS S3 — used when STORAGE_BACKEND=s3. Defaults shown.
# -----------------------------------------------------------------------------
# S3_BUCKET_RAW=retail-raw
# S3_BUCKET_BRONZE=retail-bronze
# S3_BUCKET_SILVER=retail-silver
# S3_BUCKET_GOLD=retail-gold
# AWS_REGION=ap-southeast-2

# -----------------------------------------------------------------------------
# PostgreSQL (analytics warehouse)
# -----------------------------------------------------------------------------
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_warehouse
POSTGRES_PORT=5432

# Connection string for dbt, Metabase, warehouse loader
# DATABASE_URL=postgresql://retail:retail@localhost:5432/retail_warehouse

# -----------------------------------------------------------------------------
# Optional: Airflow (when added)
# -----------------------------------------------------------------------------
# AIRFLOW_UID=50000
# AIRFLOW__CORE__EXECUTOR=LocalExecutor
